# Copy to .env and fill in. Never commit .env.

# --- LLMs (any LiteLLM model string) -----------------------------------------
# Check your provider's current model list; names change.
DIAGNOSIS_MODEL=groq/llama-3.3-70b-versatile
REPAIR_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Agent behaviour ---------------------------------------------------------
SHP_MAX_ATTEMPTS=3
SHP_CONFIDENCE_THRESHOLD=0.6
# docker | local | auto (auto = docker if the shp-sandbox image exists)
SHP_SANDBOX_BACKEND=auto

# --- Pull requests -------------------------------------------------------------
# Leave these empty for dry-run mode (PRs are written to reports/prs/).
GITHUB_TOKEN=
GITHUB_REPO=           # owner/name
GITHUB_WEBHOOK_SECRET=

# --- What to heal ---------------------------------------------------------------
# The repo the healer works on (it reads healer.yaml there; default: this checkout)
# SHP_WORKDIR=/path/to/your/pipeline/repo
# Which pipeline in healer.yaml, when it lists several (default: the first)
# SHP_PIPELINE=
# Referenced from healer.yaml as ${WAREHOUSE_DSN} for a Postgres sink
# (this one is the Postgres from docker compose)
# WAREHOUSE_DSN=postgresql://healer:healer@localhost:5433/warehouse

# --- Streaming (python -m stream.server) ---------------------------------------
# kafka = Redpanda from docker compose; memory = no broker, everything in one process;
# auto = kafka if reachable, otherwise memory
SHP_BUS=auto
KAFKA_BOOTSTRAP=localhost:19092
# records per second from the built-in demo producer. Whether it runs follows healer.yaml's
# source.demo_producer (on for the demo, off for real topics); SHP_EMBEDDED_PRODUCER=0 or 1 overrides
SHP_RATE=25
# SHP_EMBEDDED_PRODUCER=
# detection: rolling window, minimum quarantined records and share of traffic, silence timeout
SHP_WINDOW_S=10
SHP_MIN_BAD=5
SHP_MIN_DLQ_RATE=0.02
SHP_SILENCE_S=12
# oracle = scripted stand-in for the LLM, to demo the whole loop without an API key
SHP_FAKE_LLM=
SHP_PORT=8100

# --- Batch pipeline ------------------------------------------------------------
UPSTREAM_URL=http://localhost:8000

# --- Optional tracing (needs `pip install langfuse`) --------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
